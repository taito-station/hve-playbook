#!/usr/bin/env bash
# hve-playbook の pre-push: knowledge の検査（ADR 0014 の dogfood）
#
# 有効化: git config core.hooksPath .githooks
#
# push するコミットを stdin（<local ref> <local sha> <remote ref> <remote sha>）から受け、
# 決定ログの不変性をそのコミットで検査する。knowledge 文書の検査は作業ツリーで行う。
# 導入先で使う場合は hve-scripts/ を .claude/scripts/hve/ に読み替える。

set -u
ROOT="$(git rev-parse --show-toplevel)"
SCRIPTS="$ROOT/hve-scripts"

if ! command -v python3 >/dev/null 2>&1; then
    # 検査を黙って飛ばすと改ざんを見逃すので止める（fail-closed）
    echo "[pre-push] python3 が無いため knowledge の検査ができません。push を止めます" >&2
    exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;          # 通常の push
        *) continue ;;      # ブランチの削除（sha がすべて 0）
    esac
    python3 "$SCRIPTS/check-decision-log.py" --head "$local_sha" || status=1
done

python3 "$SCRIPTS/check-knowledge.py" || status=1

if [ "$status" -ne 0 ]; then
    echo "[pre-push] knowledge の検査に失敗したため push を止めました" >&2
fi
exit "$status"
