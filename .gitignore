# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Windows / NTFS (WSL マウント越しに混入する Zone.Identifier 等)
*:Zone.Identifier

# Local ignores
*.local
.env

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code
.claude/worktrees/
**/.claude/settings.local.json

# HVE 一時作業ファイル
work/

# create-pr / review-pr 一時ファイル
docs/temp/

# mdq / cq のローカル索引（再生成できる。利用記録 usage.jsonl を含む）
# 設定ファイルは追跡できるよう、ディレクトリではなく中身を除外する（`.mdq/` と書くと `!` の例外が効かない）
.mdq/*
!.mdq/config.toml
.cq/*
!.cq/config.toml
